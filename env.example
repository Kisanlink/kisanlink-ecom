# E-commerce Service Configuration
PORT=8080
GIN_MODE=debug
API_VERSION=v1

# Database Configuration
DB_PROVIDER=postgres
DB_POSTGRES_HOST=localhost
DB_POSTGRES_PORT=5432
DB_POSTGRES_USER=postgres
DB_POSTGRES_PASSWORD=password
DB_POSTGRES_DBNAME=kisanlink_ecom
DB_POSTGRES_SSLMODE=disable
DB_POSTGRES_MAX_CONNS=10
DB_POSTGRES_IDLE_CONNS=5

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRY=24h

# AAA Service Configuration
AAA_ENDPOINT=localhost:50051
AAA_GRPC_SERVER_ADDR=localhost:50051
AAA_TIMEOUT_MS=5000
AAA_RETRIES=3

# AAA Service Security Configuration
AAA_GRPC_TLS_ENABLED=false
AAA_GRPC_CERT_PATH=/etc/certs/aaa-client.crt
AAA_GRPC_KEY_PATH=/etc/certs/aaa-client.key
AAA_GRPC_CA_PATH=/etc/certs/ca.crt
AAA_GRPC_SERVER_NAME=aaa-service

# AAA Service Resilience Configuration
AAA_CIRCUIT_BREAKER_ENABLED=true
AAA_CIRCUIT_BREAKER_MAX_FAILURES=5
AAA_CIRCUIT_BREAKER_RESET_TIMEOUT_SECONDS=30

# Integration Configuration
WEBHOOK_SECRET=your-webhook-secret-here

# Redis Configuration (if used)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Email Configuration (if used)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json

# CORS Configuration
ALLOWED_ORIGINS=*
