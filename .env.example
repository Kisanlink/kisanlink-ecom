# ==============================================
# KisanLink E-Commerce API Configuration
# ==============================================

# Server Configuration
PORT=8080
GIN_MODE=debug
API_VERSION=v1

# ==============================================
# Database Configuration
# ==============================================

# Database Provider: postgres, dynamodb, or inmemory
DB_PROVIDER=postgres

# PostgreSQL Configuration (for local Docker setup)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_NAME=kisanlink_ecom
DB_SSLMODE=disable

# Connection Pool Settings
DB_MAX_CONNS=25
DB_MAX_IDLE_TIME=300

# Alternative: Full connection string (optional, overrides individual settings)
# DB_CONNECTION_STRING=postgres://postgres:your_secure_password_here@localhost:5432/kisanlink_ecom?sslmode=disable

# ==============================================
# AWS Configuration (for DynamoDB - optional)
# ==============================================

# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# ==============================================
# JWT Configuration
# ==============================================

JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_2024
JWT_EXPIRY=24h

# ==============================================
# Redis Configuration (optional)
# ==============================================

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ==============================================
# Email Configuration (optional)
# ==============================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password

# ==============================================
# File Upload Configuration
# ==============================================

UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10MB

# ==============================================
# CORS Configuration
# ==============================================

# For development, allow all origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000

# For production, specify exact origins:
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ==============================================
# Logging Configuration
# ==============================================

LOG_LEVEL=debug
LOG_FORMAT=json

# Available log levels: debug, info, warn, error, fatal, panic
# Available log formats: json, text
