# ==============================================
# KisanLink E-Commerce API Configuration
# ==============================================

# Server Configuration
PORT=8080
GIN_MODE=debug
API_VERSION=v1

# ==============================================
# Database Configuration
# ==============================================

# Database Provider: postgres, dynamodb, or inmemory
DB_PROVIDER=postgres

# PostgreSQL Configuration (for local Docker setup)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=dev_password_123
DB_NAME=kisanlink_ecom
DB_SSLMODE=disable

# Connection Pool Settings
DB_MAX_CONNS=25
DB_MAX_IDLE_TIME=300

# Alternative: Full connection string (optional, overrides individual settings)
# DB_CONNECTION_STRING=postgres://postgres:dev_password_123@localhost:5432/kisanlink_ecom?sslmode=disable

# ==============================================
# AWS Configuration (for DynamoDB - optional)
# ==============================================

# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# ==============================================
# JWT Configuration
# ==============================================

JWT_SECRET=dev_jwt_secret_change_this_in_production_2024
JWT_EXPIRY=24h

# ==============================================
# Redis Configuration (optional)
# ==============================================

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ==============================================
# Email Configuration (optional)
# ==============================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password

# ==============================================
# File Upload Configuration
# ==============================================

UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10MB

# ==============================================
# CORS Configuration
# ==============================================

# For development, allow all origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000

# For production, specify exact origins:
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ==============================================
# Logging Configuration
# ==============================================

LOG_LEVEL=debug
LOG_FORMAT=text

# Available log levels: debug, info, warn, error, fatal, panic
# Available log formats: json, text

# ==============================================
# Development Configuration
# ==============================================

# Hot reload (for development)
HOT_RELOAD=true

# Debug mode
DEBUG=true

# ==============================================
# Docker Configuration
# ==============================================

# PostgreSQL (for Docker Compose)
POSTGRES_PASSWORD=dev_password_123
POSTGRES_PORT=5432

# Redis (for Docker Compose)
REDIS_PORT=6379

# pgAdmin (for Docker Compose)
PGADMIN_EMAIL=admin@kisanlink.local
PGADMIN_PASSWORD=admin123
PGADMIN_PORT=5050

# Redis Commander (for Docker Compose)
REDIS_COMMANDER_USER=admin
REDIS_COMMANDER_PASSWORD=admin123
REDIS_COMMANDER_PORT=8081

# Documentation server
DOCS_PORT=8082

# Nginx (for production)
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ==============================================
# Monitoring Configuration
# ==============================================

# Health check configuration
HEALTH_CHECK_TIMEOUT=10
HEALTH_CHECK_INTERVAL=30

# Metrics configuration
METRICS_ENABLED=true
METRICS_PORT=9090

# ==============================================
# Security Configuration
# ==============================================

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# HTTPS (for production)
TLS_ENABLED=false
TLS_CERT_FILE=
TLS_KEY_FILE=

# ==============================================
# Feature Flags
# ==============================================

# Enable/disable features
FEATURE_CATALOG_MANAGEMENT=true
FEATURE_ORDER_MANAGEMENT=true
FEATURE_INVENTORY_MANAGEMENT=true
FEATURE_USER_MANAGEMENT=true
FEATURE_ANALYTICS=false
